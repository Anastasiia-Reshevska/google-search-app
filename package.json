{
  "name": "google-search-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file=.env src/js/server.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node src/js/server.js",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "test": "node --test",
    "preview": "concurrently -k \"node --env-file=.env src/js/server.js\" \"vite preview\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.93.2",
    "stylelint": "^17.16.0",
    "stylelint-order": "^8.1.2",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "normalize.css": "^8.0.1"
  }
}
